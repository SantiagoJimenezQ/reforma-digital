---
import { Image } from 'astro:assets';
import shot from '../assets/screens/original-2-provincias.png';

// Coordenadas sobre la captura de 1280 × 700 px.
const W = 1280;
const H = 700;
const marks = [
  {
    n: 1,
    box: [258, 110, 404, 146],
    at: [420, 128],
    dy: 8,
    text: 'Las 52 provincias, en un desplegable sin buscador.',
  },
  {
    n: 2,
    box: [60, 234, 582, 258],
    at: [600, 246],
    dy: 0,
    text: 'El aviso de "lea atentamente" va después del botón.',
  },
  {
    n: 3,
    box: [64, 168, 264, 208],
    at: [282, 188],
    dy: 0,
    text: 'Aceptar no dice qué pasa al pulsarlo.',
  },
  {
    n: 4,
    box: [60, 58, 420, 94],
    at: [436, 76],
    dy: -10,
    text: 'Nada indica cuántos pasos quedan ni en cuál estás.',
  },
];
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
---

<div class="annotated">
  <div class="shot">
    <Image
      src={shot}
      alt="Captura de la pantalla de provincias de la cita previa de Extranjería, sin Reforma Digital."
      widths={[640, 1280]}
      sizes="(max-width: 900px) 100vw, 900px"
    />
    {
      marks.map((m, i) => (
        <>
          <span
            class="box"
            aria-hidden="true"
            style={`left:${pct(m.box[0]!, W)};top:${pct(m.box[1]!, H)};width:${pct(m.box[2]! - m.box[0]!, W)};height:${pct(m.box[3]! - m.box[1]!, H)}`}
          />
          <span
            class="pin"
            aria-hidden="true"
            style={`left:${pct(m.at[0]!, W)};top:${pct(m.at[1]!, H)}`}
          >
            {m.n}
          </span>
          <span
            class="bubble"
            aria-hidden="true"
            style={`left:${pct(m.at[0]!, W)};top:calc(${pct(m.at[1]!, H)} + ${m.dy}px);--d:${i}`}
          >
            {m.text}
          </span>
        </>
      ))
    }
  </div>
  <ol class="notes">
    {
      marks.map((m) => (
        <li>
          <span class="n" aria-hidden="true">
            {m.n}
          </span>
          {m.text}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .shot {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: #f6f6f6;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .box {
    position: absolute;
    border: 2px solid var(--navy);
    border-radius: 6px;
    background: rgb(21 44 92 / 0.06);
  }

  .pin {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border-radius: 999px;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    box-shadow: 0 0 0 3px #fff;
  }

  .bubble {
    position: absolute;
    z-index: 1;
    white-space: nowrap;
    margin-left: 22px;
    padding: 6px 12px;
    border-radius: 10px;
    background: var(--navy);
    color: #fff;
    font-size: 13px;
    line-height: 1.35;
    transform: translateY(-50%);
    box-shadow: 0 10px 24px -12px rgb(21 44 92 / 0.6);
    animation: pop 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(200ms + var(--d) * 120ms);
  }

  .bubble::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    background: var(--navy);
    transform: rotate(45deg);
    border-radius: 2px;
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translate(-6px, -50%);
    }
  }

  .notes {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    gap: 12px;
  }

  @media (min-width: 721px) {
    .notes {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }

  .notes li {
    display: flex;
    gap: 12px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .n {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: 1px solid var(--navy);
    color: var(--navy);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  @media (max-width: 720px) {
    .bubble {
      display: none;
    }

    .pin {
      width: 20px;
      height: 20px;
      margin: -10px 0 0 -10px;
      font-size: 10px;
    }

    .notes {
      display: grid;
    }
  }
</style>
