---
// Valores reales del select#form oficial (fixture del 27/09/2026).
const options = [
  { name: 'Madrid', value: '/icpplustiem/citar?p=28&locale=es' },
  { name: 'Barcelona', value: '/icpplustieb/citar?p=8&locale=es' },
  { name: 'Valencia', value: '/icpplus/citar?p=46&locale=es' },
  { name: 'Sevilla', value: '/icpplus/citar?p=41&locale=es' },
  { name: 'Málaga', value: '/icpplustie/citar?p=29&locale=es' },
  { name: 'Alicante', value: '/icpco/citar?p=3&locale=es' },
];

const t = (s: string) => `<span class="text-ink-subtle">${s}</span>`;
const a = (s: string) => `<span class="text-ink">${s}</span>`;
const q = (s: string) => `<span class="text-brand-600">"${s}"</span>`;
const c = (s: string) => `<span class="text-[#94a3b8]">${s}</span>`;
const lines: { html: string; opt?: string }[] = [
  { html: c('&lt;!-- #divProvincias --&gt;') },
  { html: `${t('&lt;select')} ${a('id')}=${q('form')}${t('&gt;')}` },
  { html: `  ${t('&lt;option')} ${a('value')}=${q('')}${t('&gt;')}Selecciona Provincia ...${t('&lt;/option&gt;')}` },
  ...options.map((o) => ({
    opt: o.value,
    html: `  ${t('&lt;option')} ${a('value')}=${q(`…p=${o.value.match(/p=(\d+)/)?.[1]}`)}<span class="hidden text-[#b45309] [[data-selected]_&]:inline"> selected</span>${t('&gt;')}${o.name}${t('&lt;/option&gt;')}`,
  })),
  { html: c('  …46 provincias más') },
  { html: t('&lt;/select&gt;') },
  { html: `${t('&lt;input')} ${a('id')}=${q('btnAceptar')} ${a('type')}=${q('button')} ${a('value')}=${q('Aceptar')}${t('&gt;')}` },
];

const choice =
  'flex min-h-11 cursor-pointer items-center gap-2.5 rounded-control border border-line-strong bg-surface px-3 py-2 text-[15px] hover:border-line-control focus-within:border-brand-600 focus-within:shadow-[0_0_0_3px_rgb(var(--bg-brand-200))] data-[checked]:border-brand-600 data-[checked]:bg-brand-50 data-[checked]:font-semibold data-[checked]:text-brand-900 data-[checked]:shadow-[inset_0_0_0_1px_rgb(var(--bg-brand-600))] [&_input]:m-0 [&_input]:size-[18px] [&_input]:accent-brand-600';
---

<div
  class="grid grid-cols-1 items-stretch gap-0 rounded-[14px] border border-line bg-[#fafafa] p-[clamp(12px,2vw,20px)] min-[961px]:grid-cols-[minmax(0,1fr)_72px_minmax(0,1.3fr)]"
  data-bridge
>
  <div class="flex min-w-0 flex-col gap-5 rounded-card border border-line bg-surface p-[clamp(20px,2.4vw,28px)] text-ink shadow-none">
    <p class="mb-0 font-mono text-[11px] uppercase tracking-[0.08em] text-ink-subtle">Lo que ves · Reforma Digital</p>
    <fieldset class="m-0 border-0 p-0">
      <legend class="mb-3 p-0 text-[22px] font-bold tracking-[-0.01em]">Elige la provincia</legend>
      <div class="grid grid-cols-2 gap-2">
        {
          options.map((o) => (
            <label class={choice} data-choice>
              <input type="radio" name="bridge-provincia" value={o.value} data-name={o.name} />
              {o.name}
            </label>
          ))
        }
      </div>
    </fieldset>
    <button type="button" class="bg-btn bg-btn-primary self-start" disabled data-go>
      Elige una provincia para continuar
    </button>
  </div>

  <div class="relative grid h-16 place-items-center min-[961px]:h-auto">
    <span
      class="absolute inset-y-0 left-1/2 border-l-[1.5px] border-dashed border-line-strong min-[961px]:inset-x-0 min-[961px]:top-1/2 min-[961px]:bottom-auto min-[961px]:left-auto min-[961px]:border-l-0 min-[961px]:border-t-[1.5px]"
      aria-hidden="true"></span>
    <span
      class="relative rounded-md border border-line bg-white px-2 py-1.5 font-mono text-[10px] uppercase text-ink-muted"
      >DomBridge</span
    >
    <span
      class="absolute left-0 top-1/2 mt-[-5px] hidden size-2.5 rounded-full bg-ink opacity-0 min-[961px]:block"
      data-pulse
    ></span>
  </div>

  <div class="flex min-w-0 flex-col rounded-card border border-line bg-white p-[clamp(20px,2.4vw,28px)]">
    <p class="mb-4 font-mono text-[11px] uppercase tracking-[0.08em] text-ink-subtle">
      Lo que pasa debajo · web oficial
    </p>
    <pre class="m-0 overflow-x-auto whitespace-pre font-mono text-[11.5px] leading-[1.7] text-ink" aria-label="Estado del select oficial"><code>{
      lines.map((line) => (
        <span
          class:list={[
            'mx-[-6px] block min-w-max rounded px-1.5 transition-colors duration-[250ms] data-[selected]:bg-[#f5f5f5] data-[selected]:shadow-[inset_2px_0_0_rgb(var(--bg-ink))]',
            { opt: line.opt },
          ]}
          data-opt={line.opt}
          set:html={line.html}
        />
      ))
    }</code></pre>
    <div
      class="mt-4 min-h-[118px] border-t border-line pt-3.5 font-mono text-[12.5px] leading-[1.7] [&_p]:whitespace-pre-wrap [&_p]:[overflow-wrap:anywhere]"
      role="log"
      aria-live="polite"
      aria-label="Registro del puente"
      data-log
    >
      <p class="text-[#94a3b8]" data-idle>Elige una provincia en el panel.</p>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-bridge]')!;
  const log = root.querySelector<HTMLElement>('[data-log]')!;
  const go = root.querySelector<HTMLButtonElement>('[data-go]')!;
  const pulse = root.querySelector<HTMLElement>('[data-pulse]')!;
  let chosen: HTMLInputElement | null = null;

  const entryClass = {
    cmd: 'whitespace-pre-wrap [overflow-wrap:anywhere] text-ink',
    evt: 'whitespace-pre-wrap [overflow-wrap:anywhere] text-ink-subtle',
    ok: 'whitespace-pre-wrap [overflow-wrap:anywhere] text-success-fg',
  } as const;

  const write = (rows: ['cmd' | 'evt' | 'ok', string][]) => {
    log.querySelector('[data-idle]')?.remove();
    for (const [kind, text] of rows) {
      const p = document.createElement('p');
      p.className = entryClass[kind];
      p.textContent = kind === 'cmd' ? `$ ${text}` : text;
      log.append(p);
    }
    while (log.children.length > 7) log.firstElementChild!.remove();
    pulse.classList.remove('animate-travel');
    void pulse.offsetWidth;
    pulse.classList.add('animate-travel');
  };

  root.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    if (input.name !== 'bridge-provincia') return;
    chosen = input;
    root.querySelectorAll<HTMLElement>('[data-choice]').forEach((choice) => {
      choice.toggleAttribute('data-checked', choice.contains(input));
    });
    root.querySelectorAll<HTMLElement>('[data-opt]').forEach((option) => {
      option.toggleAttribute('data-selected', option.dataset.opt === input.value);
    });
    go.disabled = false;
    go.textContent = `Continuar con ${input.dataset.name}`;
    write([
      ['cmd', `bridge.set(select#form, "${input.dataset.name}")`],
      ['evt', '  dispara los eventos input y change'],
    ]);
  });

  go.addEventListener('click', () => {
    if (!chosen) return;
    write([
      ['cmd', 'bridge.click(#btnAceptar)'],
      ['ok', `  la web oficial navega a ${chosen.value.split('&')[0]}`],
    ]);
  });
</script>
