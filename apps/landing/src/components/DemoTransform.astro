---
import { LockKeyhole } from '@lucide/astro';
import { categorias, servicios } from '../data/aeat';
import { pasos } from '../site';

const domain = 'www2.agenciatributaria.gob.es';

// Mismas clases que la extensión (packages/design/tailwind-preset.js): la demo no define estilos propios.
const choice = 'bg-choice [&[hidden]]:!hidden';
---

<div class="m-0 flex flex-col gap-4 min-[861px]:flex-row" data-demo>
  <div class="flex min-w-0 flex-1 flex-col gap-3">
    <p class="text-center font-mono text-sm font-medium uppercase tracking-[0.12em] text-danger-fg">Sin Reforma Digital</p>
    <div class="overflow-hidden rounded-[18px] border border-line bg-surface text-ink" data-browser>
    <div class="flex items-center gap-3 border-b border-line bg-surface-muted py-2.5 pl-4 pr-3">
      <span class="flex gap-1.5 max-[1100px]:hidden" aria-hidden="true">
        <i class="size-[10px] rounded-full bg-line-strong"></i>
        <i class="size-[10px] rounded-full bg-line-strong"></i>
        <i class="size-[10px] rounded-full bg-line-strong"></i>
      </span>
      <span
        class="flex h-[32px] min-w-0 flex-1 items-center gap-2 overflow-hidden whitespace-nowrap rounded-lg border border-line bg-surface px-3 font-mono text-[11px] text-ink-subtle"
      >
        <LockKeyhole size={13} strokeWidth={1.7} aria-hidden="true" />
        <span class="truncate text-ink">{domain}</span>
      </span>
    </div>
    <div class="relative h-[clamp(500px,52vw,620px)] overflow-hidden">
      <div
        class="absolute inset-0 overflow-auto overscroll-contain bg-white px-5 pb-8 pt-5 font-[Arial,sans-serif] text-[#222]"
        data-view="legacy"
      >
        <div class="flex items-center gap-2.5">
          <span class="h-10 w-[90px] shrink-0 bg-[repeating-linear-gradient(-45deg,#dedede_0_6px,#e8e8e8_6px_12px)]" aria-hidden="true"></span>
          <span class="ml-1 text-[18px] leading-tight text-[#555]"
            >Agencia Tributaria<small class="block text-[12px] font-bold">Sede electrónica</small></span
          >
          <span class="ml-auto bg-[#666] px-4 py-2.5 text-xs font-bold text-white max-[560px]:hidden" aria-hidden="true">ÁREA PERSONAL</span>
        </div>
        <div class="mt-3 h-1.5 bg-[#666]" aria-hidden="true"></div>
        <h3 class="mt-6 text-[22px] font-bold leading-tight">Catálogo de servicios de asistencia</h3>
        <p class="mt-2 max-w-[640px] text-[15px]">
          Conoce los diferentes servicios de asistencia que presta la Agencia Tributaria y los diferentes
          canales por los que puede acceder
        </p>
        <div class="mt-3 flex gap-10 text-[15px] text-[#555]">
          <span>Índice:</span>
          <ol class="m-0 list-none p-0 leading-[1.8]">
            {categorias.slice(0, 5).map((c, i) => <li class={i >= 4 ? 'opacity-40' : undefined}>{i + 1}. {c}</li>)}
          </ol>
        </div>
        <p class="mb-6 border-b border-[#ddd] pb-2 text-center text-[#666]" aria-hidden="true">⌄</p>
        {
          categorias.map((c) => (
            <section>
              <h4 class="mb-3 mt-6 text-[21px] font-bold">{c}</h4>
              {servicios
                .filter((s) => s.category === c)
                .map((s) => (
                  <div
                    class="mb-3 border border-[#ddd] px-5 py-4 shadow-[0_1px_3px_rgb(0_0_0/0.15)] transition-[outline-color] data-[picked]:outline data-[picked]:outline-2 data-[picked]:outline-[#777]"
                    data-legacy={s.id}
                  >
                    <p class="flex flex-wrap justify-between gap-2 border-b border-[#eee] pb-2 text-[15px]">
                      <span>
                        Servicio: <b>{s.name}</b>
                      </span>
                      <span class="text-[#777]">
                        Canales: <span class="tracking-[3px]" aria-hidden="true">{s.channels.map(() => '▣').join('')}</span>
                      </span>
                    </p>
                    {s.description && <p class="mt-2 text-sm">{s.description}</p>}
                    <button
                      type="button"
                      class="mx-auto mt-3 block w-full max-w-[500px] bg-[#666] py-2.5 text-sm font-bold text-white"
                      title={`Solicitar asistencia y cita para ${s.name}`}
                      data-legacy-request={s.id}
                    >
                      Solicita asistencia y cita
                    </button>
                  </div>
                ))}
            </section>
          ))
        }
      </div>
    </div>
    </div>
  </div>

  <div class="flex min-w-0 flex-1 flex-col gap-3">
    <p class="text-center font-mono text-sm font-medium uppercase tracking-[0.12em] text-success-fg">Con Reforma Digital</p>
    <div class="overflow-hidden rounded-[18px] border border-line bg-surface text-ink" data-browser>
    <div class="flex items-center gap-3 border-b border-line bg-surface-muted py-2.5 pl-4 pr-3">
      <span class="flex gap-1.5 max-[1100px]:hidden" aria-hidden="true">
        <i class="size-[10px] rounded-full bg-line-strong"></i>
        <i class="size-[10px] rounded-full bg-line-strong"></i>
        <i class="size-[10px] rounded-full bg-line-strong"></i>
      </span>
      <span
        class="flex h-[32px] min-w-0 flex-1 items-center gap-2 overflow-hidden whitespace-nowrap rounded-lg border border-line bg-surface px-3 font-mono text-[11px] text-ink-subtle"
      >
        <LockKeyhole size={13} strokeWidth={1.7} aria-hidden="true" />
        <span class="truncate text-ink">{domain}</span>
      </span>
    </div>
    <div class="relative h-[clamp(500px,52vw,620px)] overflow-hidden">
      <div
        class="absolute inset-0 overflow-auto overscroll-contain bg-canvas px-4 pb-8 pt-4"
        data-view="enhanced"
      >
        <p class="bg-eyebrow mb-2">Catálogo de servicios de asistencia</p>

        <div class="bg-card bg-text p-4 sm:p-6">
          <p class="bg-h1 !text-[24px]">Encuentra tu servicio de asistencia</p>
          <p class="bg-lead mt-2 !text-base">
            Busca entre los {servicios.length} servicios que publica la Agencia Tributaria. Al solicitar uno, la web
            oficial te pedirá tu NIF y tu nombre.
          </p>
          <p class="bg-eyebrow mt-5">Paso 1 de 5 · {pasos[0]}</p>
          <ol class="m-0 mb-5 mt-2 grid list-none grid-cols-5 gap-2 p-0 max-[900px]:gap-1">
            {
              pasos.map((paso, i) => (
                <li class:list={['bg-step !items-center', i === 0 ? 'bg-step-current' : 'bg-step-todo']}>
                  <span class="bg-step-num">{i + 1}</span>
                  <span class="sr-only">
                    {paso}
                    {i > 0 && ' (solo en la web oficial)'}
                  </span>
                </li>
              ))
            }
          </ol>
          <div class="grid gap-3">
            <div>
              <label class="bg-label" for="demo-search">Buscar servicio</label>
              <input
                id="demo-search"
                class="bg-field bg-field-search"
                type="search"
                placeholder="Ej.: clave, renta, embargo…"
                autocomplete="off"
                data-search
              />
            </div>
            <div>
              <label class="bg-label" for="demo-category">Categoría</label>
              <select
                id="demo-category"
                class="bg-field"
                data-category
              >
                <option value="">Todas</option>
                {categorias.map((c) => <option value={c}>{c}</option>)}
              </select>
            </div>
          </div>
          <p class="bg-eyebrow mb-2 mt-4" aria-live="polite" data-count>
            {servicios.length} servicios
          </p>
          <div class="grid max-h-[340px] gap-2 overflow-auto overscroll-contain rounded-control bg-surface-muted p-2" role="radiogroup" aria-label="Servicios de asistencia" data-choices>
            {
              servicios.map((s) => (
                <label class={choice} data-name={s.name} data-cat={s.category} data-choice>
                  <input type="radio" name="demo-servicio" value={s.id} />
                  <span class="grid gap-1">
                    <span class="bg-eyebrow !text-[11px]">{s.category}</span>
                    <span class="text-[15px] font-semibold leading-snug">{s.name}</span>
                    <span class="flex flex-wrap gap-1.5">
                      {s.channels.map((ch) => (
                        <span class="rounded-full border border-line bg-surface px-2 py-0.5 text-xs font-normal text-ink-muted">{ch}</span>
                      ))}
                    </span>
                  </span>
                </label>
              ))
            }
            <p class="text-[15px] text-ink-muted" hidden data-empty>Ningún servicio coincide.</p>
          </div>
          <div class="mt-4">
            <button type="button" class="bg-btn bg-btn-primary" disabled data-continue>
              Elige un servicio para continuar
            </button>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
</div>

<script>
  import { normalize } from '../site';

  for (const demo of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    const search = demo.querySelector<HTMLInputElement>('[data-search]')!;
    const category = demo.querySelector<HTMLSelectElement>('[data-category]')!;
    const count = demo.querySelector<HTMLElement>('[data-count]')!;
    const choices = [...demo.querySelectorAll<HTMLLabelElement>('[data-choice]')];
    const empty = demo.querySelector<HTMLElement>('[data-empty]')!;
    const cont = demo.querySelector<HTMLButtonElement>('[data-continue]')!;
    const legacy = demo.querySelector<HTMLElement>('[data-view="legacy"]')!;

    const select = (id: string) => {
      let name = '';
      for (const choice of choices) {
        const input = choice.querySelector('input')!;
        input.checked = input.value === id;
        choice.classList.toggle('bg-choice-checked', input.checked);
        if (input.checked) name = choice.dataset.name!;
      }
      legacy.querySelectorAll<HTMLElement>('[data-legacy]').forEach((card) => {
        card.toggleAttribute('data-picked', card.dataset.legacy === id);
      });
      cont.disabled = !id;
      cont.textContent = id ? `Solicitar asistencia y cita: ${name}` : 'Elige un servicio para continuar';
    };

    const filter = () => {
      const q = normalize(search.value.trim());
      const cat = category.value;
      let shown = 0;
      for (const choice of choices) {
        const match = (!q || normalize(choice.dataset.name!).includes(q)) && (!cat || choice.dataset.cat === cat);
        choice.hidden = !match;
        if (match) shown++;
      }
      empty.hidden = shown > 0;
      count.textContent = `${shown} ${shown === 1 ? 'servicio' : 'servicios'}`;
    };

    search.addEventListener('input', filter);
    category.addEventListener('change', filter);
    demo.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === 'demo-servicio') select(target.value);
    });
    legacy.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-legacy-request]');
      if (button) select(button.dataset.legacyRequest!);
    });

  }
</script>
