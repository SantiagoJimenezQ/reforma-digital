---
import { pasos, provincias } from '../site';

const domain = 'icp.administracionelectronica.gob.es';

const choice =
  'flex min-h-11 cursor-pointer items-center gap-2.5 rounded-control border border-line-strong bg-surface px-3 py-2 text-[15px] transition-[border-color,background-color] duration-150 hover:border-line-control focus-within:border-brand-600 focus-within:shadow-[0_0_0_3px_rgb(var(--bg-brand-200))] data-[checked]:border-brand-600 data-[checked]:bg-brand-50 data-[checked]:font-semibold data-[checked]:text-brand-900 data-[checked]:shadow-[inset_0_0_0_1px_rgb(var(--bg-brand-600))] [&[hidden]]:!hidden [&_input]:m-0 [&_input]:size-[18px] [&_input]:accent-brand-600';
---

<div class="group m-0" data-demo data-on="false">
  <div class="overflow-hidden rounded-[18px] border border-line bg-surface text-ink shadow-[0_1px_2px_rgb(0_0_0/0.04)]">
    <div class="flex items-center gap-4 border-b border-line bg-surface-muted py-2.5 pl-4 pr-3">
      <span class="flex gap-1.5 max-[900px]:hidden" aria-hidden="true">
        <i class="size-[11px] rounded-full bg-line-strong"></i>
        <i class="size-[11px] rounded-full bg-line-strong"></i>
        <i class="size-[11px] rounded-full bg-line-strong"></i>
      </span>
      <span
        class="flex h-[34px] min-w-0 flex-1 items-center gap-2 overflow-hidden whitespace-nowrap rounded-lg border border-line bg-surface px-3 font-mono text-xs text-ink-subtle"
      >
        <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M4.5 7V5a3.5 3.5 0 0 1 7 0v2M3.5 7h9v7h-9z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
        <span class="text-ink">{domain}</span><span class="truncate max-[560px]:hidden">/icpplus/index.html</span>
      </span>
      <button
        type="button"
        class="inline-flex min-h-10 cursor-pointer items-center gap-2.5 rounded-[10px] border border-line bg-surface py-0 pl-3 pr-2 text-sm font-semibold text-ink-subtle transition-[color,border-color,background-color] duration-200 hover:border-line-strong group-data-[on=true]:border-brand-200 group-data-[on=true]:bg-brand-50 group-data-[on=true]:text-brand-700"
        role="switch"
        aria-checked="false"
        data-switch
      >
        <svg width="18" height="18" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M16 3.5 28 10l-12 6.5L4 10z" fill="currentColor"></path>
          <path
            d="m4 15.5 12 6.5 12-6.5M4 21.5 16 28l12-6.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linejoin="round"
            stroke-linecap="round"></path>
        </svg>
        <span class="max-[900px]:hidden">Reforma Digital</span>
        <span
          class="relative h-[22px] w-9 rounded-full bg-line-strong transition-colors duration-[250ms] ease-soft group-data-[on=true]:bg-brand-600"
          aria-hidden="true"
        >
          <span
            class="absolute left-[3px] top-[3px] size-4 rounded-full bg-white shadow-[0_1px_2px_rgb(15_23_42/0.3)] transition-transform duration-[250ms] ease-soft group-data-[on=true]:translate-x-[14px]"
          ></span>
        </span>
      </button>
    </div>

    <div class="relative h-[clamp(520px,62vw,660px)] overflow-hidden">
      <div
        class="absolute inset-0 overflow-auto overscroll-contain bg-[#f4f4f4] px-[clamp(16px,3vw,32px)] pb-8 pt-5 font-[Verdana,Tahoma,sans-serif] text-[#333] transition-[opacity,transform,filter] duration-500 ease-soft group-data-[on=true]:scale-[0.98] group-data-[on=true]:opacity-0 group-data-[on=true]:blur-sm"
        data-view="legacy"
      >
        <div class="flex items-center gap-2.5">
          <span class="h-11 w-[120px] bg-[repeating-linear-gradient(-45deg,#dedede_0_6px,#e8e8e8_6px_12px)]" aria-hidden="true"></span>
          <span
            class="h-11 w-[90px] bg-[repeating-linear-gradient(-45deg,#dedede_0_6px,#e8e8e8_6px_12px)] max-[560px]:hidden"
            aria-hidden="true"></span>
          <span class="ml-3 text-[22px] font-bold leading-tight text-[#3a3a3a]"
            >Sede electrónica<small class="block text-[13px] font-normal max-[560px]:hidden">Administraciones Públicas</small></span
          >
        </div>
        <div class="mt-4 flex gap-[22px] overflow-hidden whitespace-nowrap bg-[#6b6b6b] px-3.5 py-[9px] text-xs text-white" aria-hidden="true">
          <span>INICIO</span><span>PROCEDIMIENTOS</span><span>MIS EXPEDIENTES</span><span>MIS NOTIFICACIONES</span><span>AYUDA</span>
        </div>
        <div class="mt-7 border border-[#ddd] bg-white px-[26px] py-[22px]">
          <p class="text-[22px] text-[#5a5a5a]">CITA PREVIA EXTRANJERÍA</p>
          <label class="mt-[18px] flex items-center gap-[22px] text-xs max-[560px]:flex-col max-[560px]:items-start max-[560px]:gap-2">
            <span>PROVINCIAS DISPONIBLES</span>
            <select class="w-[140px] border border-[#aab] bg-[#eef6f9] p-1 font-[Arial,sans-serif] text-xs" data-official>
              <option value="">Selecciona Provincia ...</option>
              {provincias.map((p) => <option value={p}>{p}</option>)}
            </select>
          </label>
          <div class="mt-5 flex gap-1.5">
            <button type="button" class="border border-[#555] bg-[#777] px-[22px] py-[9px] font-[Arial,sans-serif] text-xs text-white" tabindex="-1">Aceptar</button>
            <button type="button" class="border border-[#555] bg-[#777] px-[22px] py-[9px] font-[Arial,sans-serif] text-xs text-white" tabindex="-1">Volver</button>
          </div>
          <p class="mt-[26px] text-sm font-bold text-[#555]">ATENCIÓN, LEA ATENTAMENTE ANTES DE ACEPTAR UNA CITA:</p>
          <ul class="m-0 mt-2.5 list-disc pl-[18px] text-[11px] leading-[1.8]">
            <li>
              Si usted es Residente temporal o tiene una estancia por estudios, y tiene certificado
              digital se recomienda el uso de la plataforma MERCURIO para renovar.
            </li>
            <li>Puede descargar el Modelo oficial de solicitud.</li>
            <li>Puede descargar la Información sobre trámites y procedimientos.</li>
            <li>Si desea obtener el certificado digital, puede hacerlo en FNMT‑RCM.</li>
          </ul>
        </div>
      </div>

      <div
        class="absolute inset-0 translate-y-[18px] scale-[0.985] overflow-auto overscroll-contain bg-canvas px-[clamp(12px,3vw,40px)] pb-8 pt-5 opacity-0 transition-[opacity,transform,filter] duration-500 ease-soft group-data-[on=true]:translate-y-0 group-data-[on=true]:scale-100 group-data-[on=true]:opacity-100"
        data-view="enhanced"
      >
        <div class="flex flex-col items-start justify-between gap-4 bg-card px-4 py-3 min-[561px]:flex-row min-[561px]:items-center">
          <div>
            <span class="bg-badge">
              <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true">
                <path
                  d="M8 1.5 13.5 4v4c0 3.2-2.3 5.6-5.5 6.5C4.8 13.6 2.5 11.2 2.5 8V4z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"></path>
              </svg>
              Interfaz comunitaria · sitio oficial
            </span>
            <p class="mt-1.5 text-sm text-ink-muted">
              Estás en <strong class="text-ink">{domain}</strong>, la web oficial del trámite. Los datos y envíos los
              gestiona esa web.
            </p>
          </div>
          <button type="button" class="bg-btn bg-btn-secondary" data-original>Ver original</button>
        </div>

        <p class="mb-2 mt-4 text-xs font-semibold uppercase tracking-[0.06em] text-ink-subtle">Cita previa extranjería</p>

        <div class="bg-card p-[clamp(16px,2.4vw,28px)]">
          <p class="text-[clamp(22px,2.2vw,28px)] font-bold leading-[1.2] tracking-[-0.01em]">Elige la provincia</p>
          <p class="mt-1.5 text-base text-ink-muted">
            Selecciona la provincia en la que quieres pedir la cita. La lista es la que ofrece la web
            oficial.
          </p>
          <p class="mt-5 text-xs font-semibold uppercase tracking-[0.06em] text-ink-subtle">Paso 2 de 5</p>
          <ol class="m-0 mb-5 mt-2 grid list-none grid-cols-5 gap-2 p-0 max-[900px]:gap-1">
            {
              pasos.map((paso, i) => (
                <li
                  class:list={[
                    'grid content-start gap-1.5 rounded-control border border-line p-2.5 text-[13px] leading-snug text-ink-muted max-[900px]:justify-items-center max-[900px]:p-1.5',
                    {
                      'border-brand-600 bg-brand-50 font-semibold text-brand-900': i === 1,
                      'border-dashed': i === 4,
                    },
                  ]}
                >
                  <span
                    class:list={[
                      'grid size-[22px] place-items-center rounded-full bg-surface-muted text-xs font-bold',
                      { 'bg-success-bg text-success-fg': i === 0, 'bg-brand-600 text-white': i === 1 },
                    ]}
                  >
                    {i === 0 ? '✓' : i + 1}
                  </span>
                  <span class="max-[900px]:hidden">{paso}</span>
                </li>
              ))
            }
          </ol>
          <label class="mb-1.5 block text-[15px] font-semibold" for="demo-search">
            Buscar provincia <span class="font-normal text-ink-subtle">({provincias.length})</span>
          </label>
          <input
            id="demo-search"
            class="block min-h-11 w-full rounded-control border border-line-control bg-surface px-3.5 py-2.5 text-base focus:border-brand-600 focus:shadow-[0_0_0_3px_rgb(var(--bg-brand-200))] focus:outline-none"
            type="search"
            placeholder="Ej.: avila, malaga, illes…"
            autocomplete="off"
            data-search
          />
          <div class="mt-3 grid grid-cols-2 gap-2 min-[901px]:grid-cols-4" role="radiogroup" aria-label="Provincias disponibles" data-choices>
            {
              provincias.map((p) => (
                <label class={choice} data-name={p} data-choice>
                  <input type="radio" name="demo-provincia" value={p} />
                  {p}
                </label>
              ))
            }
            <p class="col-span-full text-[15px] text-ink-muted" hidden data-empty>Ninguna provincia coincide.</p>
          </div>
          <div class="mt-5">
            <button type="button" class="bg-btn bg-btn-primary" disabled data-continue>
              Elige una provincia para continuar
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const normalize = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .toLowerCase();

  for (const demo of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    const toggle = demo.querySelector<HTMLButtonElement>('[data-switch]')!;
    const original = demo.querySelector<HTMLButtonElement>('[data-original]')!;
    const search = demo.querySelector<HTMLInputElement>('[data-search]')!;
    const official = demo.querySelector<HTMLSelectElement>('[data-official]')!;
    const choices = [...demo.querySelectorAll<HTMLLabelElement>('[data-choice]')];
    const empty = demo.querySelector<HTMLElement>('[data-empty]')!;
    const cont = demo.querySelector<HTMLButtonElement>('[data-continue]')!;
    const views = demo.querySelectorAll<HTMLElement>('[data-view]');
    let touched = false;

    const setOn = (on: boolean) => {
      demo.dataset.on = String(on);
      toggle.setAttribute('aria-checked', String(on));
      views.forEach((view) => {
        const visible = (view.dataset.view === 'enhanced') === on;
        view.inert = !visible;
        view.setAttribute('aria-hidden', String(!visible));
      });
    };

    const select = (name: string) => {
      official.value = name;
      for (const choice of choices) {
        const input = choice.querySelector('input')!;
        input.checked = choice.dataset.name === name;
        choice.toggleAttribute('data-checked', input.checked);
      }
      cont.disabled = !name;
      cont.textContent = name ? `Continuar con ${name}` : 'Elige una provincia para continuar';
    };

    toggle.addEventListener('click', () => {
      touched = true;
      setOn(demo.dataset.on !== 'true');
    });
    original.addEventListener('click', () => {
      touched = true;
      setOn(false);
      toggle.focus();
    });
    search.addEventListener('input', () => {
      const q = normalize(search.value.trim());
      let shown = 0;
      for (const choice of choices) {
        const match = !q || normalize(choice.dataset.name!).includes(q);
        choice.hidden = !match;
        if (match) shown++;
      }
      empty.hidden = shown > 0;
    });
    demo.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement | HTMLSelectElement;
      if (target === official || target.name === 'demo-provincia') select(target.value);
    });
    demo.addEventListener('pointerdown', () => (touched = true), { once: true });

    setOn(false);
    const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    setTimeout(() => !touched && setOn(true), motionOk ? 1600 : 0);
  }
</script>
