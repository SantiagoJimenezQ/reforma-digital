---
import Logo from './Logo.astro';
import { authors, links } from '../site';
---

<footer class="border-t border-line py-10">
  <div
    class="mx-auto flex w-full max-w-page flex-wrap items-center justify-between gap-x-8 gap-y-4 px-[var(--gutter)]"
  >
    <Logo size={26} />
    <p class="max-w-[60ch] text-sm text-ink-subtle">
      Proyecto independiente y comunitario, sin vinculación con la Administración. Los trámites se
      completan siempre en la web oficial.
    </p>
    <div class="grid gap-1 text-sm text-ink-subtle">
      <p>
        <a class="text-inherit" href={links.license}>Licencia MIT</a> · 2026
      </p>
      <p>
        Made by{' '}
        {
          authors.map((author, index) => (
            <>
              {index === authors.length - 1 ? ' & ' : index > 0 ? ', ' : null}
              <a
                class="text-ink underline decoration-line-strong underline-offset-[3px] hover:decoration-ink"
                href={author.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {author.name}
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            </>
          ))
        }
      </p>
    </div>
  </div>
</footer>
