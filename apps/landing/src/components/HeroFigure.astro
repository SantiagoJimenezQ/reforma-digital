---
const choices = ['Madrid', 'Barcelona', 'Valencia', 'Sevilla', 'Málaga', 'Alicante'];
---

<figure class="m-0" aria-labelledby="hf-caption" data-hf>
  <div class="mx-auto grid max-w-[880px] grid-cols-1 items-stretch gap-3 sm:grid-cols-[minmax(0,1fr)_72px_minmax(0,1fr)] sm:gap-0">
    <div class="grid h-full grid-rows-[1fr_auto] justify-items-center gap-3.5">
      <div
        class="h-full w-full max-w-[360px] select-none overflow-hidden rounded-[10px] border border-[#ddd] bg-[#f2f2f2] p-3 font-[Verdana,Tahoma,sans-serif] text-[#555] grayscale"
        aria-hidden="true"
      >
        <div class="flex items-center gap-[5px]">
          <span class="h-5 w-10 bg-[repeating-linear-gradient(-45deg,#d9d9d9_0_3px,#e6e6e6_3px_6px)]"></span>
          <span class="h-5 w-10 bg-[repeating-linear-gradient(-45deg,#d9d9d9_0_3px,#e6e6e6_3px_6px)]"></span>
          <b class="ml-1.5 text-xs">Sede electrónica</b>
        </div>
        <div class="mt-2 h-2.5 bg-[#7a7a7a]"></div>
        <p class="mt-3.5 text-sm text-[#666]">CITA PREVIA EXTRANJERÍA</p>
        <div class="mt-2.5 flex items-center gap-2 text-[8px]">
          <span>PROVINCIAS DISPONIBLES</span>
          <span class="border border-[#a9b1bb] bg-white px-1 py-0.5 font-[Arial,sans-serif] text-[9px]">Selecciona Provi… ▾</span>
        </div>
        <div class="mt-2 flex gap-[3px]">
          <span class="bg-[#7a7a7a] px-3 py-[5px] font-[Arial,sans-serif] text-[9px] text-white">Aceptar</span>
          <span class="bg-[#7a7a7a] px-3 py-[5px] font-[Arial,sans-serif] text-[9px] text-white">Volver</span>
        </div>
        <p class="mt-3.5 text-[8px] font-bold">ATENCIÓN, LEA ATENTAMENTE ANTES DE ACEPTAR UNA CITA:</p>
        <div class="mt-2.5 grid gap-[7px]">
          <i class="h-1 bg-[#d4d4d4]"></i><i class="h-1 w-4/5 bg-[#d4d4d4]"></i><i class="h-1 bg-[#d4d4d4]"></i><i
            class="h-1 w-4/5 bg-[#d4d4d4]"></i
          ><i class="h-1 bg-[#d4d4d4]"></i><i class="h-1 w-4/5 bg-[#d4d4d4]"></i><i class="h-1 bg-[#d4d4d4]"></i><i
            class="h-1 w-4/5 bg-[#d4d4d4]"></i
          >
        </div>
      </div>
      <p class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink-subtle">La web de siempre</p>
    </div>

    <div class="grid place-items-center">
      <span class="grid size-10 place-items-center rounded-full bg-brand-900 text-white max-sm:rotate-90" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 16 16">
          <path
            d="M3 8h10M9 4l4 4-4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>

    <div class="grid h-full grid-rows-[1fr_auto] justify-items-center gap-3.5">
      <div
        class="grid h-full w-full max-w-[360px] content-start gap-[9px] overflow-hidden rounded-[10px] border border-line bg-surface p-4 text-ink shadow-[0_12px_30px_-18px_rgb(21_44_92/0.35)] select-none"
        aria-hidden="true"
      >
        <span
          class="justify-self-start animate-rev rounded-full border border-brand-200 bg-brand-50 px-[7px] py-0.5 text-[9.5px] font-semibold text-brand-700 [animation-delay:500ms]"
          >Interfaz comunitaria · sitio oficial</span
        >
        <p class="animate-rev text-[19px] font-bold tracking-[-0.01em] [animation-delay:620ms]">Elige la provincia</p>
        <p class="animate-rev text-[8.5px] font-semibold uppercase tracking-[0.06em] text-ink-subtle [animation-delay:740ms]">
          Paso 2 de 5
        </p>
        <ol class="m-0 mt-[-2px] grid list-none grid-cols-5 gap-1 p-0 animate-rev [animation-delay:740ms]">
          <li class="grid h-5 place-items-center rounded-[5px] border border-line text-[9px] font-bold text-success-fg">✓</li>
          <li class="grid h-5 place-items-center rounded-[5px] border border-brand-600 bg-brand-50 text-[9px] font-bold text-brand-700">2</li>
          <li class="grid h-5 place-items-center rounded-[5px] border border-line text-[9px] font-bold text-ink-subtle">3</li>
          <li class="grid h-5 place-items-center rounded-[5px] border border-line text-[9px] font-bold text-ink-subtle">4</li>
          <li class="grid h-5 place-items-center rounded-[5px] border border-dashed border-line text-[9px] font-bold text-ink-subtle">5</li>
        </ol>
        <span
          class="animate-rev rounded-md border border-line-control px-2.5 py-[7px] text-[10px] text-ink-subtle [animation-delay:860ms]"
          >Buscar provincia</span
        >
        <div class="grid animate-rev grid-cols-3 gap-1 [animation-delay:980ms]">
          {
            choices.map((c, i) => (
              <span
                class:list={[
                  'flex items-center gap-1 rounded-md border px-2 py-[7px] text-[10px] transition-[background-color,border-color,color] duration-300',
                  i === 0
                    ? 'border-brand-600 bg-brand-50 font-semibold text-brand-900'
                    : 'border-line-strong',
                ]}
                data-choice
                data-selected={i === 0 ? '' : undefined}
              >
                <i
                  class:list={[
                    'size-[7px] shrink-0 rounded-full',
                    i === 0 ? 'border-[2.5px] border-brand-600' : 'border border-line-control',
                  ]}
                />
                {c}
              </span>
            ))
          }
        </div>
        <span
          class="mt-0.5 justify-self-start animate-rev rounded-md bg-brand-600 px-3 py-[7px] text-[10px] font-semibold text-white [animation-delay:1100ms]"
          data-button>Continuar con Madrid</span
        >
      </div>
      <p class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink-subtle">La misma web, paso a paso</p>
    </div>
  </div>
  <figcaption id="hf-caption" class="sr-only">
    A la izquierda, la pantalla de provincias de la cita previa de Extranjería tal y como se ve hoy. A
    la derecha, la misma pantalla con Reforma Digital, con pasos numerados, buscador y opciones
    grandes.
  </figcaption>
</figure>

<script>
  const root = document.querySelector<HTMLElement>('[data-hf]');
  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const choices = [...root.querySelectorAll<HTMLElement>('[data-choice]')];
    const button = root.querySelector<HTMLElement>('[data-button]')!;
    const on = ['border-brand-600', 'bg-brand-50', 'font-semibold', 'text-brand-900'];
    const off = ['border-line-strong'];
    let i = 0;
    setInterval(() => {
      const previous = choices[i]!;
      previous.classList.remove(...on);
      previous.classList.add(...off);
      previous.querySelector('i')!.className = 'size-[7px] shrink-0 rounded-full border border-line-control';
      i = (i + 1) % choices.length;
      const next = choices[i]!;
      next.classList.remove(...off);
      next.classList.add(...on);
      next.querySelector('i')!.className = 'size-[7px] shrink-0 rounded-full border-[2.5px] border-brand-600';
      button.textContent = `Continuar con ${next.textContent!.trim()}`;
    }, 2200);
  }
</script>
