---
import { ArrowRight, Search } from '@lucide/astro';
import { servicios } from '../data/aeat';
import { normalize } from '../site';

// Búsquedas reales sobre el catálogo oficial: los resultados salen de los datos, no están escritos a mano.
const words = ['clave', 'renta', 'embargo', 'nif'];
const queries = words.map((q) => {
  const found = servicios.filter((s) => normalize(s.name).includes(q));
  return { q, total: found.length, shown: found.slice(0, 3) };
});
const legacyCards = servicios.slice(0, 3);
---

<figure
  class="m-0"
  aria-label={`El catálogo de servicios de asistencia de la Agencia Tributaria, con ${servicios.length} servicios uno debajo de otro, y la misma página con un buscador.`}
  data-hf data-words={words.join(',')}>
  <div class="mx-auto grid max-w-[880px] grid-cols-1 items-stretch gap-3 sm:grid-cols-[minmax(0,1fr)_72px_minmax(0,1fr)] sm:gap-0">
    <div class="grid h-full justify-items-center motion-safe:animate-rise">
      <div
        class="h-full w-full max-w-[360px] select-none overflow-hidden rounded-[10px] border border-[#ddd] bg-white p-3 font-[Arial,sans-serif] text-[#222] grayscale"
        aria-hidden="true"
      >
        <div class="flex items-center gap-[5px]">
          <span class="h-5 w-10 bg-[repeating-linear-gradient(-45deg,#d9d9d9_0_3px,#e6e6e6_3px_6px)]"></span>
          <b class="ml-1 text-[11px] font-normal text-[#666]">Agencia Tributaria</b>
          <span class="ml-auto bg-[#555] px-2 py-1 text-[7px] font-bold text-white">ÁREA PERSONAL</span>
        </div>
        <div class="mt-2 h-[3px] bg-[#555]"></div>
        <p class="mt-3 text-[13px] font-bold">Catálogo de servicios de asistencia</p>
        <div class="mt-1.5 grid grid-cols-[auto_1fr] gap-x-3 text-[7.5px] leading-[1.6] text-[#777]">
          <span>Índice:</span>
          <span
            >1. Identificación electrónica<br />2. Trámites destacados<br />3. Pagar, aplazar y consultar deudas<br /><span
              class="opacity-40">4. Registro y notificaciones</span
            ></span
          >
        </div>
        <div class="mt-2 grid gap-2">
          {
            legacyCards.map((s) => (
              <div class="border border-[#ddd] px-2 py-1.5 shadow-[0_1px_2px_rgb(0_0_0/0.12)]">
                <p class="flex justify-between gap-2 border-b border-[#eee] pb-1 text-[8px]">
                  <span class="truncate">
                    Servicio: <b>{s.name}</b>
                  </span>
                  <span class="shrink-0 tracking-[2px] text-[#888]">▣▣▣</span>
                </p>
                <span class="mx-auto mt-1.5 block w-3/4 bg-[#555] py-1 text-center text-[7.5px] font-bold text-white">
                  Solicita asistencia y cita
                </span>
              </div>
            ))
          }
        </div>
        <p class="mt-2 text-center text-[8px] text-[#999]">… y {servicios.length - legacyCards.length} servicios más, uno debajo de otro</p>
      </div>
    </div>

    <div class="grid place-items-center">
      <span class="grid size-10 place-items-center rounded-full bg-brand-900 text-white max-sm:rotate-90 motion-safe:animate-rise motion-safe:[animation-delay:220ms]" aria-hidden="true">
        <ArrowRight size={18} strokeWidth={1.7} aria-hidden="true" />
      </span>
    </div>

    <div class="grid h-full justify-items-center motion-safe:animate-rise motion-safe:[animation-delay:380ms]">
      <div
        class="grid h-full w-full max-w-[360px] content-start gap-[9px] overflow-hidden rounded-[10px] border border-line bg-surface p-4 text-ink shadow-[0_12px_30px_-18px_rgb(21_44_92/0.35)] select-none"
        aria-hidden="true"
      >
        <span
          class="flex items-center gap-1.5 rounded-md border border-brand-600 px-2.5 py-[7px] text-[10px] text-ink shadow-[0_0_0_2px_rgb(var(--bg-brand-200))]"
        >
          <Search size={11} strokeWidth={1.8} class="text-ink-subtle" aria-hidden="true" />
          <span data-query>{queries[0]!.q}</span><span class="h-3 w-px animate-pulse bg-ink"></span>
        </span>
        <div>
          {
            queries.map((r, i) => (
              <div class="grid gap-1.5" data-result hidden={i !== 0}>
                <p class="text-[8.5px] font-semibold uppercase tracking-[0.06em] text-ink-subtle">
                  {r.total} {r.total === 1 ? 'servicio' : 'servicios'}
                </p>
                {r.shown.map((s) => (
                  <span class="grid gap-0.5 rounded-xl border border-line bg-white px-3 py-2">
                    <span class="truncate text-[7.5px] font-semibold uppercase tracking-[0.05em] text-ink-subtle">{s.category}</span>
                    <span class="flex items-center justify-between gap-2 text-[10.5px] font-semibold">
                      <span class="truncate">{s.name}</span>
                      <span class="shrink-0 rounded-[5px] border border-line-control px-1.5 py-0.5 text-[8px] font-semibold">
                        Solicitar →
                      </span>
                    </span>
                  </span>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</figure>

<script>
  const root = document.querySelector<HTMLElement>('[data-hf]');
  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const query = root.querySelector<HTMLElement>('[data-query]')!;
    const results = [...root.querySelectorAll<HTMLElement>('[data-result]')];
    const words = root.dataset.words!.split(',');
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let i = 0;
    const loop = async () => {
      await wait(2400);
      i = (i + 1) % words.length;
      results.forEach((r) => (r.hidden = true));
      for (let n = 0; n <= words[i]!.length; n++) {
        query.textContent = words[i]!.slice(0, n);
        await wait(n ? 90 : 250);
      }
      results[i]!.hidden = false;
      loop();
    };
    loop();
  }
</script>
