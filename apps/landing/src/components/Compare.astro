---
import { Image } from 'astro:assets';
import original1 from '../assets/screens/original-1-landing.png';
import mejorada1 from '../assets/screens/mejorada-1-landing.png';
import original2 from '../assets/screens/original-2-provincias.png';
import mejorada2 from '../assets/screens/mejorada-2-provincias.png';
import original3 from '../assets/screens/original-3-tramites.png';
import mejorada3 from '../assets/screens/mejorada-3-tramites.png';
import original4 from '../assets/screens/original-4-info.png';
import mejorada4 from '../assets/screens/mejorada-4-info.png';

const steps = [
  {
    id: 'informacion',
    tab: 'Información',
    title: 'Información del trámite',
    text: 'La página informativa se resume en qué es el trámite y quién debe pedirlo. Un solo botón para empezar pulsa "Acceder al Procedimiento" en la web oficial.',
    before: original1,
    after: mejorada1,
  },
  {
    id: 'provincia',
    tab: 'Provincia',
    title: 'Provincia',
    text: 'Un buscador sin tildes recorre la lista oficial de 52 provincias. Continuar pulsa el botón Aceptar de la web, y los avisos oficiales siguen a la vista.',
    before: original2,
    after: mejorada2,
  },
  {
    id: 'tramite',
    tab: 'Oficina y trámite',
    title: 'Oficina y trámite',
    text: 'Los trámites aparecen agrupados por organismo y con buscador. Si la web oficial muestra un error, el panel lo repite junto al campo.',
    before: original3,
    after: mejorada3,
  },
  {
    id: 'requisitos',
    tab: 'Requisitos',
    title: 'Requisitos y forma de acceso',
    text: 'El panel te pide leer primero la información oficial del trámite. Después muestra las dos vías de acceso, con Cl@ve y sin Cl@ve, sin destacar ninguna.',
    before: original4,
    after: mejorada4,
  },
];

const shot = 'absolute inset-0 h-full w-full object-cover object-left-top';
---

<div class="grid gap-4" data-compare>
  <div class="flex flex-wrap gap-2" role="tablist" aria-label="Pasos del trámite">
    {
      steps.map((step, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${step.id}`}
          aria-controls={`panel-${step.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          class="inline-flex min-h-10 cursor-pointer items-center gap-2 rounded-full border border-line bg-white py-0 pl-2 pr-3.5 font-sans text-sm font-medium leading-none text-ink-muted transition-[background-color,color,border-color] duration-150 ease-soft hover:border-[#94a3b8] aria-[selected=true]:border-ink aria-[selected=true]:text-ink"
        >
          <span class="grid size-6 place-items-center rounded-full bg-[#f5f5f5] font-mono text-[11px] [[aria-selected=true]_&]:bg-ink [[aria-selected=true]_&]:text-white">
            {index + 1}
          </span>
          {step.tab}
        </button>
      ))
    }
  </div>
  <div class="grid gap-4 rounded-[14px] border border-line bg-[#fafafa] p-[clamp(8px,1.6vw,16px)]">
    {
      steps.map((step, index) => (
        <div
          class="relative isolate aspect-[1280/700] overflow-hidden rounded-lg border border-line bg-white has-[input:focus-visible]:[&_.knob]:outline has-[input:focus-visible]:[&_.knob]:outline-2 has-[input:focus-visible]:[&_.knob]:outline-offset-[3px] has-[input:focus-visible]:[&_.knob]:outline-brand-600"
          id={`panel-${step.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${step.id}`}
          hidden={index !== 0}
          style="--pos: 50%"
        >
          <Image
            src={step.after}
            alt={`${step.tab} con Reforma Digital: panel guiado sobre la web oficial`}
            class={shot}
            widths={[640, 1280]}
            sizes="(max-width: 900px) 100vw, 62vw"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
          <div class="absolute inset-0 [clip-path:inset(0_calc(100%-var(--pos))_0_0)]">
            <Image
              src={step.before}
              alt={`${step.tab} en la web oficial original`}
              class={shot}
              widths={[640, 1280]}
              sizes="(max-width: 900px) 100vw, 62vw"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </div>
          <span class="pointer-events-none absolute left-3 top-3 z-[2] rounded-full border border-line bg-white/90 px-2.5 py-1.5 font-mono text-[11px] text-ink backdrop-blur-sm max-[600px]:left-2 max-[600px]:top-2 max-[600px]:text-[10px]">
            Original
          </span>
          <span class="pointer-events-none absolute right-3 top-3 z-[2] rounded-full border border-line bg-white/90 px-2.5 py-1.5 font-mono text-[11px] text-ink backdrop-blur-sm max-[600px]:right-2 max-[600px]:top-2 max-[600px]:text-[10px]">
            Con Reforma Digital
          </span>
          <span class="pointer-events-none absolute bottom-0 top-0 z-[2] -ml-px w-0.5 bg-ink [left:var(--pos)]" aria-hidden="true">
            <span class="knob absolute left-1/2 top-1/2 grid size-10 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-line-strong bg-white text-ink shadow-[0_2px_8px_rgb(0_0_0/0.08)]">
              <svg width="18" height="18" viewBox="0 0 18 18">
                <path
                  d="M6.5 4.5 2 9l4.5 4.5M11.5 4.5 16 9l-4.5 4.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </span>
          <input
            class="absolute inset-0 z-[3] m-0 h-full w-full cursor-ew-resize opacity-0"
            type="range"
            min="0"
            max="100"
            value="50"
            data-range
            aria-label={`Comparar ${step.tab.toLowerCase()}: original a la izquierda, con Reforma Digital a la derecha`}
          />
        </div>
      ))
    }
  </div>
  <div>
    {
      steps.map((step, index) => (
        <div class="px-1 text-[15px] leading-[1.55] text-ink-muted" data-text={step.id} hidden={index !== 0}>
          <h3 class="mb-1 text-base font-semibold text-ink">{step.title}</h3>
          <p>{step.text}</p>
        </div>
      ))
    }
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-compare]')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const select = (tab: HTMLButtonElement) => {
    for (const other of tabs) {
      const active = other === tab;
      other.setAttribute('aria-selected', String(active));
      other.tabIndex = active ? 0 : -1;
      const id = other.getAttribute('aria-controls')!;
      root.querySelector<HTMLElement>(`#${id}`)!.hidden = !active;
      root.querySelector<HTMLElement>(`[data-text="${id.replace('panel-', '')}"]`)!.hidden = !active;
    }
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (event) => {
      const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!delta) return;
      event.preventDefault();
      const next = tabs[(index + delta + tabs.length) % tabs.length]!;
      next.focus();
      select(next);
    });
  });
  root.querySelectorAll<HTMLInputElement>('[data-range]').forEach((range) => {
    range.addEventListener('input', () => {
      range.parentElement!.style.setProperty('--pos', `${range.value}%`);
    });
  });
</script>
