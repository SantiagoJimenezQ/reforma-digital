---
import Logo from './Logo.astro';
import GithubIcon from './GithubIcon.astro';
import { links, nav } from '../site';
---

<section class="full-hero" aria-labelledby="hero-title">
  <div class="px-[clamp(16px,3vw,40px)]">
    <div class="flex h-[76px] items-center justify-between gap-6">
      <a href="#" class="no-underline [&_span:last-child]:!text-base" aria-label="Reforma Digital, inicio">
        <Logo size={22} />
      </a>
      <nav class="flex items-center gap-[22px]" aria-label="Principal">
        {
          nav.map((item) => (
            <a class="text-sm text-ink-muted no-underline hover:text-ink max-sm:hidden" href={item.href}>
              {item.label}
            </a>
          ))
        }
        <a
          class="inline-flex h-[38px] items-center gap-2 rounded-full bg-brand-900 px-4 text-sm font-medium text-white no-underline hover:bg-[#333] hover:text-white"
          href={links.repo}
        >
          <GithubIcon size={16} />
          Código fuente
        </a>
      </nav>
    </div>

    <div class="pt-[clamp(40px,8vw,104px)] text-center">
      <h1
        id="hero-title"
        class="font-serif text-[clamp(56px,9vw,112px)] font-normal leading-[0.95] tracking-[-0.035em] text-ink"
      >
        Reforma Digital
      </h1>
      <p class="mx-0 mb-[clamp(40px,5vw,64px)] mt-[18px] text-[clamp(17px,1.6vw,20px)] text-ink-muted">
        La próxima reforma de la Administración, hecha en comunidad.
      </p>
    </div>
  </div>
</section>
