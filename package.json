{
  "name": "reforma-digital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "sites/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @reforma-digital/web dev",
    "landing:dev": "pnpm --filter @reforma-digital/web dev",
    "landing:build": "pnpm --filter @reforma-digital/web build",
    "landing:og": "node apps/web/scripts/render-og.mjs",
    "build": "pnpm build:extension && turbo build",
    "build:test": "node scripts/build.mjs --test",
    "typecheck": "pnpm typecheck:extension && turbo typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build:test && playwright test",
    "check": "pnpm lint && pnpm check:workspaces && pnpm typecheck && pnpm test && pnpm build && pnpm audit:bundle",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error .",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "package": "pnpm check && node scripts/package.mjs",
    "site:new": "node scripts/new-site.mjs",
    "site:live": "node scripts/site-live.mjs",
    "site:record": "node scripts/site-record.mjs",
    "site:preview": "node scripts/site-preview.mjs",
    "check:workspaces": "node scripts/check-workspaces.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "tsx --env-file-if-exists=.env packages/evals/src/cli.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "feedback:export": "tsx --env-file-if-exists=.env packages/evals/src/feedback.ts",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "eval:approve": "tsx --env-file-if-exists=.env packages/evals/src/approve-baseline.ts",
    "dev:extension": "vite --config apps/playground/vite.config.ts",
    "build:extension": "node scripts/build.mjs",
    "typecheck:extension": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "dotenv": "^17.2.3",
    "@reforma-digital/design": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "vitest": "5.0.0",
    "@types/node": "26.5.0",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.2.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "vite": "8.2.2",
    "oxlint": "1.86.0",
    "ultracite": "7.12.2"
  },
  "packageManager": "pnpm@11.1.1"
}
