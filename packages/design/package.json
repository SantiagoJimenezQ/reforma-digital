    "./sol/*": "./sol/*",
    "./sol/chat": "./sol/chat.tsx"
  },
  "peerDependencies": {
    "react": "19.2.8"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "streamdown": "2.7.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
